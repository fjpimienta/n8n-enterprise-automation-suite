# --- Estructura Hosting3M Workspace (Angular & UI) ---
# Se corrige la ruta detectada en el tree: hosting3m-workspace/projects/
hosting3m-workspace/projects/**/.vscode/
hosting3m-workspace/projects/**/node_modules/
hosting3m-workspace/projects/**/dist/
hosting3m-workspace/projects/**/tmp/
hosting3m-workspace/projects/**/out-tsc/
hosting3m-workspace/projects/**/.angular/cache/
hosting3m-workspace/projects/**/src/environments/environment.prod.ts
hosting3m-workspace/projects/**/src/environments/environment.development.ts
!hosting3m-workspace/projects/**/src/environments/environment.ts

# --- Upload-file (Microservicio) ---
# Esta es la ruta exacta de tu árbol para los binarios subidos
infrastructure/upload-file/app/uploads/*
# Mantenemos la carpeta pero ignoramos el contenido
!infrastructure/upload-file/app/uploads/.gitkeep

# --- IDE Config ---
.vscode/

