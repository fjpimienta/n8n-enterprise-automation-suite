      "parameters": {
        "jsCode": "const num = (v) => (v === null || v === undefined ? null : Number(v));\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && r.plan_key)\n  .map(r => ({\n    plan_key: r.plan_key,\n    family: r.family,\n    name: r.name,\n    summary: r.summary,\n    features: Array.isArray(r.features) ? r.features : [],\n    badge: r.badge,\n    billing_period: r.billing_period,\n    price_amount: num(r.price_amount),\n    managed_amount: num(r.managed_amount),\n    promo_amount: num(r.promo_amount),\n    promo_months: r.promo_months,\n    renewal_amount: num(r.renewal_amount),\n    setup_fee: num(r.setup_fee),\n    term_months: r.term_months,\n    currency: String(r.currency || 'MXN').trim(),\n    tax_included: r.tax_included === true,\n    service_label: r.service_label,\n    price_checked_at: r.price_checked_at,\n    valid_until: r.valid_until,\n    is_featured: r.is_featured === true,\n    sort_order: r.sort_order\n  }));\nreturn [{ json: { data: rows } }];"
