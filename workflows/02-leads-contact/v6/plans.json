        "query": "SELECT plan_key, family, name, summary, features, badge, billing_period, price_amount, managed_amount, promo_amount, promo_months, renewal_amount, setup_fee, term_months, currency, tax_included, service_label, price_checked_at::text AS price_checked_at, valid_until::text AS valid_until, is_featured, sort_order FROM service_plans WHERE id_company = 1 AND is_active = true AND (valid_until IS NULL OR valid_until >= CURRENT_DATE) ORDER BY sort_order, id;",
