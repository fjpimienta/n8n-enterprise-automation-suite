    {
      "parameters": {
        "jsCode": "const src = $('Webhook Contact').first().json;\nconst b = src.body || {};\nconst h = src.headers || {};\nconst clean = (v, max) => String(v ?? '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').trim().slice(0, max);\nconst esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');\nconst f = {\n  names: clean(b.names,100), middlename: clean(b.middlename,100), lastname: clean(b.lastname,100),\n  phone: clean(b.phone,30), email: clean(b.email,150).toLowerCase(),\n  message: clean(b.message,2000), service: clean(b.service,60),\n  client_ip: clean(h['cf-connecting-ip'] || h['x-forwarded-for'] || '', 45)\n};\nconst emailOk = /^[^\\s@<>\"']+@[^\\s@<>\"']+\\.[^\\s@<>\"']+$/.test(f.email);\nconst honeypot = clean(b.empresa, 50) !== '';\nconst valid = Boolean(!honeypot && emailOk && f.names && f.lastname && f.message);\nconst out = { valid, ...f };\nfor (const k of ['names','middlename','lastname','phone','email','message','service']) out[k+'_h'] = esc(f[k]);\nreturn [{ json: out }];"
      },
