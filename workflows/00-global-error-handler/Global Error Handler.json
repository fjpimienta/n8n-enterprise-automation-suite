{
  "name": "Global Error Handler",
  "nodes": [
    {
      "parameters": {},
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -400,
        64
      ],
      "id": "f3541b51-6cfd-42c3-9960-aba2825cb16b",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "workflow_name",
              "value": "={{ $json.workflow.name }}"
            },
            {
              "name": "execution_id",
              "value": "={{ $json.execution.id }}"
            },
            {
              "name": "failed_node",
              "value": "={{ $json.execution.lastNodeExecuted }}"
            },
            {
              "name": "error_message",
              "value": "={{ $json.execution.error.message }}"
            },
            {
              "name": "error_stack",
              "value": "={{ $json.execution.error.stack }}"
            },
            {
              "name": "execution_url",
              "value": "={{ $json.execution.url }}"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        -176,
        64
      ],
      "id": "f6282dba-45c0-4f32-ad81-314ed2cee92e",
      "name": "Formatear Datos"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NTFY_ALERT_URL }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "topic",
              "value": "n8n_error"
            },
            {
              "name": "message",
              "value": "=Falló: {{ $json.workflow_name }}\nNodo: {{ $json.failed_node }}\nLink: {{ $json.execution_url }}"
            },
            {
              "name": "priority",
              "value": "high"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        48,
        160
      ],
      "id": "f142fdff-0dbc-43b2-a3a8-6b5f674a44d2",
      "name": "Alerta (Webhook/HTTP)",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO n8n_error_logs (workflow_name, execution_id, failed_node, error_message)\nVALUES (\n  LEFT(COALESCE(NULLIF($1, ''), '(desconocido)'), 255),\n  LEFT(COALESCE(NULLIF($2, ''), '(sin id)'), 100),\n  LEFT(NULLIF($3, ''), 255),\n  COALESCE(NULLIF($4, ''), '(sin mensaje)')\n);",
        "options": {
          "queryReplacement": "={{ [ $json.workflow_name ?? null, $json.execution_id ?? null, $json.failed_node ?? null, $json.error_message ?? null ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        48,
        -32
      ],
      "id": "6c97ed4e-b484-44da-bd62-0781bddb2cb2",
      "name": "Execute a SQL query",
      "credentials": {
        "postgres": {
          "id": "BQrod4uGVzM1nvLw",
          "name": "Postgres account"
        }
      }
    }
