    {
      "parameters": {
        "jsCode": "const urls = [\n  // --- FUENTES ESPECIALIZADAS EN N8N (Técnicas) ---\n  \"https://n8n.io/blog/rss/\",               // Blog oficial (Indispensable)\n  \"https://medium.com/feed/tag/n8n\",        // Tutoriales de la comunidad en Medium\n  \"https://dev.to/feed/tag/n8n\",            // Artículos técnicos de desarrolladores\n  \n  // --- FUENTES DE AGENTES IA & AUTOMATIZACIÓN (Inglés - Alta Calidad) ---\n  // Estas suelen traer la info 2 días antes que los medios en español\n  \"https://www.artificialintelligence-news.com/feed/\",\n  \"https://www.unite.ai/feed/\",\n  \"https://zapier.com/blog/feeds/latest/\",  // Aunque es competencia, hablan mucho de automatización\n  \n  // --- GOOGLE NEWS FILTRADO (Español - MX/Latam) ---\n  // Truco: Usamos operadores OR y comillas para ser precisos\n  \n  // Búsqueda 1: Específica de n8n y Workflows\n  \"https://news.google.com/rss/search?q=n8n+workflow+OR+automatizacion+de+procesos+when:24h&hl=es-419&gl=MX&ceid=MX:es-419\",\n  \n  // Búsqueda 2: Específica de Agentes Autónomos (No IA generica)\n  \"https://news.google.com/rss/search?q=agentes+ia+autonomos+OR+ai+agents+OR+crewai+OR+autogen+when:24h&hl=es-419&gl=MX&ceid=MX:es-419\"\n];\n\nreturn urls.map(url => ({ json: { url } }));"
      },
