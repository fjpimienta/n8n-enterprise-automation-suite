        "jsCode": "// Capturamos los datos directos de la página\nconst pageData = items[0].json;\n\n// Obtenemos el contenido del post (del nodo SetX)\nlet postContent = {};\ntry { \n    postContent = $('SetX').first().json; \n} catch (e) {\n    postContent = { fb_post_text: \"Post automático\", image: \"https://hosting3m.com/news-placeholder.jpg\" };\n}\n\n// Extraemos el ID de Instagram si existe\nconst igId = pageData.instagram_business_account ? pageData.instagram_business_account.id : null;\n\nreturn [{\n    json: {\n        status: \"READY\",\n        // Datos para Facebook\n        page_token: pageData.access_token,\n        page_id: pageData.id,\n        // Datos para Instagram\n        instagram_business_id: igId,\n        // Contenido compartido\n        message: postContent.fb_post_text,\n        image: postContent.image\n    }\n}];"
