            {
              "id": "e7d15066-4754-4e2e-8de3-0fa4b5e5d9cc",
              "name": "image",
              "value": "={{ \n  (() => {\n    // 1. Obtenemos el título de la noticia desde el nodo anterior (Limit)\n    const title = $('Get Articles').item.json.title;\n    \n    // 2. Definimos un prompt base para asegurar el estilo \"Tech News\"\n    // \"Futuristic technology concept art about [Titulo], high quality, 4k, trending on artstation\"\n    const prompt = `Futuristic technology concept, editorial illustration about: ${title}, high detail, 8k, professional lighting`;\n  \n    // 3. Codificamos el prompt para URL\n    const encodedPrompt = encodeURIComponent(prompt);\n  \n    // 4. Retornamos la URL de Pollinations\n    // width=1000, height=800 (Coincide con tu nodo DownloadImage), model=flux, seed=random\n    const randomSeed = Math.floor(Math.random() * 1000);\n    return `https://image.pollinations.ai/prompt/${encodedPrompt}?width=1000&height=800&model=flux&nologo=true&seed=${randomSeed}`;\n  })() \n}}{{ \n  (() => {\n    // 1. Obtenemos el título de la noticia\n    const title = $('Get Articles').item.json.title;\n    \n    // 2. DEFINIMOS UNA LISTA DE ESTILOS VARIADOS\n    // Puedes agregar o quitar los que quieras de esta lista\n    const styles = [\n      \"Futuristic technology concept art, neon blue lighting, unreal engine 5\", // El clásico\n      \"Isometric 3D render, clean white background, corporate tech style\", // Estilo limpio 3D\n      \"Minimalist flat vector art, trending on behance, colorful\", // Estilo ilustración plana\n      \"Cyberpunk city atmosphere, dark and moody, cinematic lighting\", // Estilo oscuro/hacker\n      \"Abstract data visualization, geometric shapes, network connection nodes\", // Estilo abstracto\n      \"Retro synthwave 80s style, grid background, magenta and cyan\", // Estilo Retro\n      \"Photorealistic macro photography of computer hardware, depth of field\", // Estilo realista\n      \"Digital oil painting, expressive brushstrokes, conceptual art\" // Estilo artístico\n    ];\n\n    // 3. Seleccionamos un estilo al azar de la lista\n    const randomStyle = styles[Math.floor(Math.random() * styles.length)];\n  \n    // 4. Combinamos el estilo elegido con el título\n    const prompt = `${randomStyle}, editorial illustration about: ${title}, high detail, 8k, professional quality`;\n  \n    // 5. Codificamos el prompt para URL\n    const encodedPrompt = encodeURIComponent(prompt);\n  \n    // 6. Generamos semilla aleatoria y retornamos URL\n    const randomSeed = Math.floor(Math.random() * 1000);\n    return `https://image.pollinations.ai/prompt/${encodedPrompt}?width=1000&height=800&model=flux&nologo=true&seed=${randomSeed}`;\n  })() \n}}",
              "type": "string"
            },
