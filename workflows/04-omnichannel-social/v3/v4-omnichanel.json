              "name": "li_post_text",
              "value": "={{ `💡 \"${$json.data[0].title}\". Fuente: https://hosting3m.com/#news ➡️ ${$json.data[0].url}. #TechNews #IA #FuturoDigital #Tecnología #Innovación #Hosting3M` }}",
