        "jsCode": "const nodes = [\n  \"PostToFacebookPage\",\n  \"Create X\",\n  \"Post Company\",\n  \"Post Personal\",\n  \"Paso 2: Publicar\"\n];\n\nlet success = false;\n\nfor (const node of nodes) {\n  const item = $items(node)[0];\n  if (!item) continue;\n\n  const r = item.json;\n\n  if (r?.error) continue;\n\n  if (r?.statusCode && r.statusCode >= 200 && r.statusCode < 300) {\n    success = true;\n    break;\n  }\n\n  if (r?.id || r?.post_id || r?.data?.id) {\n    success = true;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    atLeastOneSuccess: success\n  }\n}];\n"
      },
