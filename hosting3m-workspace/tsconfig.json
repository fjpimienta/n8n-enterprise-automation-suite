/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "ui-chat": [
        "projects/ui-chat/src/public-api.ts"
      ],
      "ui-chat/*": [
        "projects/ui-chat/src/lib/*"
      ],
      "ui-pdf-export": [
        "projects/ui-pdf-export/src/public-api.ts"
      ],
      "ui-pdf-export/*": [
        "projects/ui-pdf-export/src/lib/*"
      ],
      /* --- Dashboard (Hotel) --- */
      "@dashboard-core/*": [
        "projects/dashboard/src/app/core/*"
      ],
      "@dashboard-features/*": [
        "projects/dashboard/src/app/features/*"
      ],
      "@dashboard-env/*": [
        "projects/dashboard/src/environments/*"
      ],
      "@dashboard-shared/*": [
        "projects/dashboard/src/app/shared/*"
      ],
      /* --- Pista de Hielo --- */
      "@pista-core/*": [
        "projects/pista-hielo/src/app/core/*"
      ],
      "@pista-features/*": [
        "projects/pista-hielo/src/app/features/*"
      ],
      "@pista-env/*": [
        "projects/pista-hielo/src/environments/*"
      ],
      "@pista-shared/*": [
        "projects/pista-hielo/src/app/shared/*"
      ],
      /* --- Cattle Dashboard --- */
      "@cattle-core/*": [
        "projects/cattle-dashboard/src/app/core/*"
      ],
      "@cattle-features/*": [
        "projects/cattle-dashboard/src/app/features/*"
      ],
      "@cattle-env/*": [
        "projects/cattle-dashboard/src/environments/*"
      ],
      "@cattle-shared/*": [
        "projects/cattle-dashboard/src/app/shared/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/ui-chat/tsconfig.lib.json"
    },
    {
      "path": "./projects/ui-chat/tsconfig.spec.json"
    },
    {
      "path": "./projects/dashboard/tsconfig.app.json"
    },
    {
      "path": "./projects/dashboard/tsconfig.spec.json"
    },
    {
      "path": "./projects/pista-hielo/tsconfig.app.json"
    },
    {
      "path": "./projects/pista-hielo/tsconfig.spec.json"
    },
    {
      "path": "./projects/hotel-website/tsconfig.app.json"
    },
    {
      "path": "./projects/hotel-website/tsconfig.spec.json"
    },
    {
      "path": "./projects/cattle-dashboard/tsconfig.app.json"
    },
    {
      "path": "./projects/cattle-dashboard/tsconfig.spec.json"
    }
  ]
}