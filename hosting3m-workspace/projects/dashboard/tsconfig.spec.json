/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": [
      "vitest/globals"
    ],
    /* 👇 AGREGAMOS ESTO: Definimos la base local y los atajos que tu código busca */
    "baseUrl": ".",
    "paths": {
      "ui-chat": [
        "../ui-chat/src/public-api.ts"
      ],
      "ui-chat/*": [
        "../ui-chat/src/lib/*"
      ],
      "ui-pdf-export": [
        "../ui-pdf-export/src/public-api.ts"
      ],
      "ui-pdf-export/*": [
        "../ui-pdf-export/src/lib/*"
      ],
      "@core/*": [
        "src/app/core/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@features/*": [
        "src/app/features/*"
      ],
      "@env/*": [
        "src/environments/*"
      ],
      "@auth/*": [
        "src/app/core/auth/*"
      ],
      "@models/*": [
        "src/app/core/models/*"
      ],
      "@ui/*": [
        "src/app/shared/ui/*"
      ]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts",
    "src/test-setup.ts"
  ]
}