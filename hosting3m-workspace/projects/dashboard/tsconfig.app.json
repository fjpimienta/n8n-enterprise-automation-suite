{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "ui-pdf-export": [
        "../ui-pdf-export/src/public-api.ts"
      ],
      "ui-pdf-export/*": [
        "../ui-pdf-export/src/lib/*"
      ],
      "ui-chat": [
        "../ui-chat/src/public-api.ts"
      ],
      "ui-chat/*": [
        "../ui-chat/src/lib/*"
      ],
      "@core/*": [
        "src/app/core/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@features/*": [
        "src/app/features/*"
      ],
      "@env/*": [
        "src/environments/*"
      ],
      "@auth/*": [
        "src/app/core/auth/*"
      ],
      "@models/*": [
        "src/app/core/models/*"
      ],
      "@ui/*": [
        "src/app/shared/ui/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../projects/ui-pdf-export/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}