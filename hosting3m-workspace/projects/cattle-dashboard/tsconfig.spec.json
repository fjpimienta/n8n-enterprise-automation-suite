{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals"],
    "baseUrl": "./",
    "paths": {
      "@env/*": ["src/environments/*"],
      "@features/*": ["src/app/features/*"],
      "@core/*": ["src/app/core/*"],
      "@shared/*": ["src/app/shared/*"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts"]
}
