FROM n8nio/n8n:2.29.0

USER root

RUN npm install -g jsonwebtoken && \
    mkdir -p /home/node/.n8n/custom && \
    npm cache clean --force && \
    # Neutralize task runner binary to prevent spawn
    mv /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@n8n+task-runner*/node_modules/@n8n/task-runner/dist/start.js \
       /usr/local/lib/node_modules/n8n/node_modules/.pnpm/@n8n+task-runner*/node_modules/@n8n/task-runner/dist/start.js.disabled 2>/dev/null || true

USER node
