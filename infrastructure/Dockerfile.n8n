# Pinned to n8n 2.29.0, the version running in production. DO NOT change to latest.
FROM n8nio/n8n:2.29.0

USER root

# pdf-parse removed from global install — crashes Task Runner via DOMMatrix.
# It remains available via NODE_FUNCTION_ALLOW_EXTERNAL as n8n bundles it internally.
# Only jsonwebtoken is required for jwt-service microservice integration.
RUN npm install -g jsonwebtoken && \
    mkdir -p /home/node/.n8n/custom && \
    npm cache clean --force

USER node
